{
  "name": "@local/dsh-cockpit",
  "version": "1.2.0",
  "description": "Custom skill categorization, drillable slash menu enhancer, and workspace cockpit panel for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js"
  },
  "scripts": {
    "zh:collect": "node scripts/collect-skills.mjs",
    "zh:embed": "node scripts/embed-i18n.mjs",
    "zh:check": "node scripts/embed-i18n.mjs --check",
    "test": "node --test tests/client.test.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
