{
  "name": "dsh-skills-cockpit",
  "version": "1.4.0",
  "description": "Grouped, drillable skill menu and a skill-usage cockpit panel for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js"
  },
  "bin": {
    "dsh-skills-cockpit": "bin/install.mjs"
  },
  "files": [
    "bin",
    "lib",
    "client.js",
    "zh-skills.json",
    "zh-i18n.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skills",
    "slash-menu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JueMingObject/dsh-skillcockpit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "zh:collect": "node scripts/collect-skills.mjs",
    "zh:embed": "node scripts/embed-i18n.mjs",
    "zh:check": "node scripts/embed-i18n.mjs --check",
    "test": "node --test tests/client.test.mjs tests/install.test.mjs",
    "install:here": "node bin/install.mjs --dev ."
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
